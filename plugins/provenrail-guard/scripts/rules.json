        {
          "id": "destructive.delete-without-where",
          "effect": "deny",
          "event_type": "tool_call",
          "arg_contains": "\\bDELETE\\s+FROM\\s+[\\\"'`]?[^\\s;\\\"'`]+[\\\"'`]?\\s*(;|\\\"|'|$)",
          "reason": "argument contains a DELETE with no WHERE clause"
        }
      ]

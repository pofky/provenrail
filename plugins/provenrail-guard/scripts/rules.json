          "event_type": "tool_call",
          "tool": "Write|Edit|MultiEdit|NotebookEdit|Bash",
          "arg_contains": "\\.provenrail\\.json\\b|\\.claude/settings(\\.local)?\\.json\\b|\\.claude/hooks\\b",
          "reason": "this edits the guardrail's own configuration"
        },
        {
          "id": "access.disable-mfa",
          "effect": "deny",
          "event_type": "tool_call",
          "not_tool": "Write|Edit|MultiEdit|NotebookEdit|Task|Agent|WebFetch|WebSearch|AskUserQuestion|TodoWrite|str_replace*|create_file|*write_file|Read|Glob|Grep",
          "arg_contains": "(disable|remove|deactivate)[\\s_-]*(mfa|2fa|two[\\s_-]?factor)",
          "reason": "argument attempts to disable multi-factor authentication"
        }
      ]
    },
    "exfiltration": {
      "title": "Data movement outward",
      "description": "Bulk reads and outbound sends, the shape of data exfiltration.",
      "rules": [
        {
          "id": "exfiltration.select-star-no-limit",
          "effect": "require_oversight",
          "event_type": "tool_call",
          "not_tool": "Write|Edit|MultiEdit|NotebookEdit|Task|Agent|WebFetch|WebSearch|AskUserQuestion|TodoWrite|str_replace*|create_file|*write_file|Read|Glob|Grep",
          "arg_contains": "\\bSELECT\\s+\\*\\s+FROM\\s+[\\\"'`]?[^\\s;\\\"'`]+[\\\"'`]?\\s*(;|\\\"|'|$)",
          "reason": "unbounded SELECT * with no WHERE or LIMIT"
        },
        {
          "id": "exfiltration.external-upload",
          "effect": "require_oversight",
          "event_type": "tool_call",
          "tool": "upload_*",
          "reason": "an outbound upload requires a recorded human approval"
        },
        {
          "id": "exfiltration.paste-sites",
          "effect": "deny",
          "event_type": "tool_call",
          "not_tool": "Write|Edit|MultiEdit|NotebookEdit|Task|Agent|WebFetch|WebSearch|AskUserQuestion|TodoWrite|str_replace*|create_file|*write_file|Read|Glob|Grep",
          "arg_contains": "\\b(pastebin\\.com|gist\\.github\\.com|transfer\\.sh|file\\.io|0x0\\.st|ix\\.io|dpaste\\.(com|org)|hastebin\\.com|sprunge\\.us|termbin\\.com|paste\\.rs|bashupload\\.com|oshi\\.at|catbox\\.moe|litterbox\\.catbox\\.moe|anonfiles\\.com|gofile\\.io|tmpfiles\\.org|ttm\\.sh|clbin\\.com|envs\\.sh|paste\\.ee|controlc\\.com)\\b",
          "reason": "argument references a public paste or file-drop site"
        }
      ]
    },
    "blast-radius": {
      "title": "Blast radius limits",
      "description": "Per-session caps, so a loop cannot do unlimited damage.",
      "rules": [
        {
          "id": "blast-radius.email-cap",
          "effect": "limit",
          "event_type": "tool_call",
          "tool": "*email*",
          "max_per_session": 25,
          "reason": "per-session email cap reached"
        },
        {
          "id": "blast-radius.message-cap",
          "effect": "limit",
          "event_type": "tool_call",
          "tool": "*message*",
          "max_per_session": 50,
          "reason": "per-session messaging cap reached"
        },
        {
          "id": "blast-radius.tool-call-cap",
          "effect": "limit",
          "event_type": "tool_call",
          "tool": "*",
          "max_per_session": 500,
          "reason": "per-session tool-call cap reached"
        }
      ]
    }
  }
}

          "reason": "argument contains a recursive delete"
        },
        {
          "id": "destructive.force-remove",
          "effect": "require_oversight",
          "event_type": "tool_call",
          "arg_contains": "\\brm\\s+((-[a-zA-Z]*f[a-zA-Z]*|--force)\\s+)+",
          "reason": "a forced delete skips every confirmation, so it needs a recorded human decision"
        },
        {
          "id": "destructive.sql-drop-or-truncate",
          "effect": "deny",
          "event_type": "tool_call",
          "arg_contains": "\\b(DROP\\s+(TABLE|DATABASE|SCHEMA|INDEX|VIEW|MATERIALIZED\\s+VIEW|FUNCTION|PROCEDURE|TRIGGER|SEQUENCE|TYPE|ROLE|USER|EXTENSION|CONSTRAINT|COLUMN|POLICY|PUBLICATION|SUBSCRIPTION|TABLESPACE)\\b|TRUNCATE\\s+(TABLE\\s+)?[\\\"'`\\w])",
          "reason": "argument contains a destructive SQL statement"

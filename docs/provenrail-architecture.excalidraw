   "locked": false,
   "fontSize": 14,
   "fontFamily": 2,
   "text": "Two independent verifiers, held in lockstep\npr verify (Python, full RFC 3161)\nweb/verify.js (browser + Node, WebCrypto)\nfrozen conformance vectors keep them identical",
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "r0072",
   "originalText": "Two independent verifiers, held in lockstep\npr verify (Python, full RFC 3161)\nweb/verify.js (browser + Node, WebCrypto)\nfrozen conformance vectors keep them identical",
   "lineHeight": 1.25,
   "autoResize": false
  },

   "seed": 1222,
   "version": 1,
   "versionNonce": 1223,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "fontSize": 13,
   "fontFamily": 2,
   "text": "What VERIFIED does and does not mean\nDoes: this chain is internally consistent, signed by one device key per session, received by the sink in this order with nothing\ninserted or deleted, and existed no later than the anchor's trusted time.\nDoes NOT: completeness. A hostile agent can decline to emit an event, and no verifier can see what was never written.\nThe sidecar narrows that gap; frequent anchoring or a client pin closes the truncated-tail gap.",
   "textAlign": "center",
   "verticalAlign": "middle",
   "containerId": "r0111",
   "originalText": "What VERIFIED does and does not mean\nDoes: this chain is internally consistent, signed by one device key per session, received by the sink in this order with nothing\ninserted or deleted, and existed no later than the anchor's trusted time.\nDoes NOT: completeness. A hostile agent can decline to emit an event, and no verifier can see what was never written.\nThe sidecar narrows that gap; frequent anchoring or a client pin closes the truncated-tail gap.",
   "lineHeight": 1.25,
   "autoResize": false
  }

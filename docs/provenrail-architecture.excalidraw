  {
   "id": "t0075",
   "type": "text",
   "x": 1368,
   "y": 318,
   "width": 344,
   "height": 174,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
